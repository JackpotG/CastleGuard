if(MACOSX)
  function(cg_configure_macos_plist target bundle_id)
    set(CG_BUNDLE_IDENTIFIER "${bundle_id}")
    if(CMAKE_OSX_DEPLOYMENT_TARGET)
      set(CG_MIN_OS_VERSION "${CMAKE_OSX_DEPLOYMENT_TARGET}")
    else()
      set(CG_MIN_OS_VERSION "11.0")
    endif()
    set(plist_path "${CMAKE_CURRENT_BINARY_DIR}/${target}-Info.plist")
    configure_file("${CMAKE_CURRENT_SOURCE_DIR}/proj.ios_mac/mac/Info.plist"
                   "${plist_path}" @ONLY)
    set_target_properties(${target} PROPERTIES MACOSX_BUNDLE_INFO_PLIST "${plist_path}")
  endfunction()
endif()

if(APPLE)
  set_target_properties(${APP_NAME} PROPERTIES RESOURCE "${APP_UI_RES}")
  set_xcode_property(${APP_NAME} INSTALL_PATH "\$(LOCAL_APPS_DIR)")
  set_xcode_property(${APP_NAME} PRODUCT_BUNDLE_IDENTIFIER "dev.stark.castleguard")

  if(MACOSX)
    cg_configure_macos_plist(${APP_NAME} "dev.stark.castleguard")
  elseif(TVOS)
    set_target_properties(${APP_NAME} PROPERTIES MACOSX_BUNDLE_INFO_PLIST "${CMAKE_CURRENT_SOURCE_DIR}/proj.ios_mac/ios/targets/tvos/Info.plist")
    set_xcode_property(${APP_NAME} ASSETCATALOG_COMPILER_APPICON_NAME "Brand Assets")
  elseif(IOS)
    set_target_properties(${APP_NAME} PROPERTIES MACOSX_BUNDLE_INFO_PLIST "${CMAKE_CURRENT_SOURCE_DIR}/proj.ios_mac/ios/targets/ios/Info.plist")
    set_xcode_property(${APP_NAME} ASSETCATALOG_COMPILER_APPICON_NAME "AppIcon")
    set_xcode_property(${APP_NAME} TARGETED_DEVICE_FAMILY "1,2")
  endif()

# For code-signing, set the DEVELOPMENT_TEAM:
# set_xcode_property(${APP_NAME} DEVELOPMENT_TEAM "GRLXXXX2K9")
elseif(WINDOWS)
  # config quick starter batch script run.bat for windows
  if(WIN32)
    file(RELATIVE_PATH CMAKE_BUILD_RELATIVE_DIR "${CMAKE_CURRENT_SOURCE_DIR}" "${PROJECT_BINARY_DIR}")
    configure_file("${CMAKE_CURRENT_SOURCE_DIR}/run.bat.in" "${CMAKE_CURRENT_SOURCE_DIR}/run.bat" @ONLY)
  endif()

  if(NOT _AX_USE_PREBUILT)
    ax_sync_target_dlls(${APP_NAME})
  endif()
endif()

if (_AX_TESTS)
  if(MACOSX)
    set_target_properties(${TEST_TARGET_NAME} PROPERTIES RESOURCE "${APP_UI_RES}")
    set_xcode_property(${TEST_TARGET_NAME} INSTALL_PATH "\$(LOCAL_APPS_DIR)")
    set_xcode_property(${TEST_TARGET_NAME} PRODUCT_BUNDLE_IDENTIFIER "dev.stark.castleguard-test")
    cg_configure_macos_plist(${TEST_TARGET_NAME} "dev.stark.castleguard-test")

    # For code-signing, set the DEVELOPMENT_TEAM:
    # set_xcode_property(${TEST_TARGET_NAME} DEVELOPMENT_TEAM "GRLXXXX2K9")
  elseif(WINDOWS)
    if(NOT _AX_USE_PREBUILT)
      ax_sync_target_dlls(${TEST_TARGET_NAME})
    endif()
  endif()
endif()
